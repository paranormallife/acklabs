{
	"apiVersion": 2,
	"name": "acklabs/clients-carousel",
	"title": "Clients Carousel",
	"description": "An auto-scrolling logo carousel for client or partner logos.",
	"category": "widgets",
	"icon": "images-alt2",
	"textdomain": "acklabs",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	}
}
